# Used by docker compose substitution (copy to `.env` in this folder).

# --- LAN only (same Wi‑Fi): leave APP_ENV unset/development; use ?tenant=slug ---
# APP_ENV=development
# PUBLIC_API_URL=http://192.168.1.100:8081/api/v1/
# PUBLIC_API_ORIGIN=http://192.168.1.100:8081/api/v1
# PUBLIC_IMAGE_URL=http://192.168.1.100:8081/
# PUBLIC_ADMIN_URL=http://192.168.1.100:7001
# PUBLIC_SUPERADMIN_URL=http://192.168.1.100:7002
# PUBLIC_WS_URL=ws://192.168.1.100:8081
# PUBLIC_SERVE_URL=http://192.168.1.100:3000

# --- Public (any network) via Cloudflare Tunnel ---
# APP_ENV=production enables https://{slug}.TENANT_BASE_DOMAIN POS URLs.
# Cloudflare Zero Trust → Tunnels → your tunnel → Public Hostname:
#   serve      → http://web:3000
#   serveapi   → http://api:8080
#   platform   → http://superadmin:8080
#   *          → http://admin:8080   (rajacafe.technirvana.com.np, etc.)
# Paste tunnel token, then: docker compose --profile tunnel up -d --build
APP_ENV=production
TENANT_BASE_DOMAIN=technirvana.com.np
PUBLIC_API_URL=https://serveapi.technirvana.com.np/api/v1/
PUBLIC_API_ORIGIN=https://serveapi.technirvana.com.np/api/v1
PUBLIC_IMAGE_URL=https://serveapi.technirvana.com.np/
PUBLIC_ADMIN_URL=https://pos.technirvana.com.np
PUBLIC_SUPERADMIN_URL=https://platform.technirvana.com.np
PUBLIC_WS_URL=wss://serveapi.technirvana.com.np
PUBLIC_SERVE_URL=https://serve.technirvana.com.np
CORS_ORIGINS=https://serve.technirvana.com.np,https://pos.technirvana.com.np,https://platform.technirvana.com.np
CLOUDFLARE_TUNNEL_TOKEN=
