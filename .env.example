# Used by docker compose substitution (copy to `.env` in this folder).
# For phone / other PCs on Wi-Fi, replace localhost with this machine's LAN IP.
# Prefer http://LAN_IP/ (gateway) — API is proxied there and needs no port.

PUBLIC_API_URL=http://localhost:8081/api/v1/
PUBLIC_API_ORIGIN=http://localhost:8081/api/v1
PUBLIC_IMAGE_URL=http://localhost:8081/
PUBLIC_ADMIN_URL=http://localhost:7001
PUBLIC_SUPERADMIN_URL=http://localhost:7002
PUBLIC_WS_URL=ws://localhost:8081
PUBLIC_SERVE_URL=http://localhost:3000
