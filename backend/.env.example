

#Database env 

#This for db
# enum are development, production , test
NODE_ENV=

#DB for dev mode
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres

#DB for staging mode
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_DIALECT=postgres

#DB for prod mode
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_NAME=
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_DIALECT=postgres


#App
APP_NAME=UNI-MOMO
PORT=8080

#this is for app
ENV=development


WEBHOOK_SECRET=justarandomsecretvalue


APP_SECRET_ENCRYPTION_KEY=

# POS admin JWT lifetime (hours). Default 72.
POS_JWT_EXPIRY_HOURS=72

# Machbank eMerchant / NEPALPAY dynamic QR

MACHBANK_EMERCHANT_ENABLED=false
MACHBANK_BASE_URL=
MACHBANK_QR_GENERATE_URL=
# MACHBANK_QR_INQUIRY_URL=
MACHBANK_WS_URL=
MACHBANK_MERCHANT_CODE=
# Merchant mid from Machbank (e.g. 1501KQZRFMY) — NCHL merchantId field
MACHBANK_MERCHANT_MID=
MACHBANK_MERCHANT_NAME=
MACHBANK_MERCHANT_CITY=Kathmandu
# NCHL doc examples use 4600 for Kathmandu
MACHBANK_MERCHANT_POSTAL_CODE=4600
# MACHBANK_QR_SPLIT_TERMINAL_LABEL=false
# NCHL token string field 7 — from Machbank; not the same as MACHBANK_USERNAME
MACHBANK_NPI_USER_ID=
MACHBANK_ACQUIRER_ID=
# ISO 18245 MCC — merchantCategoryCode in body AND in signed token string (must match bank enrollment)
MACHBANK_MCC=
MACHBANK_TERMINAL_LABEL=
MACHBANK_STORE_LABEL=
# MACHBANK_QR_REQUEST_IMAGE=false to return qrString only; bank sample uses true
MACHBANK_USERNAME=
MACHBANK_PASSWORD=
MACHBANK_WS_USERNAME=
MACHBANK_API_TOKEN=
MACHBANK_GETPAY_PUBLIC_KEY_PATH=
MACHBANK_TLS_CERT_PATH=./secrets/machbank-client.crt
MACHBANK_TLS_PRIVATE_KEY_PATH=./secrets/machbank-client.key
MACHBANK_QR_PRIVATE_KEY_PATH=./secrets/qr-signing-private.pem
MACHBANK_CURRENCY=NPR
# Security (recommended: leave true in production)
MACHBANK_REQUIRE_GETPAY_SIGNATURE=true
MACHBANK_WS_STRICT_PARSE=true
# Sandbox only: log redacted nqrws messages (ignored if NODE_ENV or ENV=production)
MACHBANK_WS_DEBUG_LOG=false
# Optional app tuning (defaults exist in config only for these)
MACHBANK_QR_EXPIRY_SECONDS=300
MACHBANK_HTTP_TIMEOUT_MS=15000
MACHBANK_WS_RECONNECT_MAX_MS=60000
MACHBANK_WS_HEARTBEAT_MS=30000

# Serve OTP + password-reset mail (same Gmail account used in POS SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USERNAME=benerdaaryae@gmail.com
EMAIL_FROM=benerdaaryae@gmail.com
EMAIL_PASSWORD=

# Platform superadmin (admin.servecafe.app / localhost:7002)
# Generate fresh values per environment: openssl rand -hex 32
PLATFORM_JWT_SECRET=cf5a88be88ccda907a687e6bf8d76bc629263ef21ce7eed5c651a0a0ca5904e3
# POS Admin JWT (min 32 chars). Required in production.
JWT_SECRET=3183555f48da3255482c65d3d7b77f2e8746bed56cae886ceb48df69c2038639
# Optional override for customer-facing JWT (defaults to `${JWT_SECRET}:customer`)
CUSTOMER_JWT_SECRET=2571bdd22b4f9ad3673af40028f754e01f4b0bfb7edf8e6beb7bc2844946143a
# Express session secret (min 32 chars in production)
SESSION_SECRET=9a828232ae042a94a3110953d07e6d86d15d95b2236a572621e115535f82d746
# Deploy webhook: set ALLOW_DEPLOY_WEBHOOK=true and a strong WEBHOOK_SECRET (>=16)
ALLOW_DEPLOY_WEBHOOK=false
WEBHOOK_SECRET=
PLATFORM_ADMIN_USERNAME=technirvana
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Tech Nirvana
# Local: POS_PUBLIC_URL=http://localhost:7001
# Production / tunnel:
# POS_PUBLIC_URL=https://pos.technirvana.com.np
# TENANT_BASE_DOMAIN=technirvana.com.np
# CORS_ORIGINS=https://serve.technirvana.com.np,https://pos.technirvana.com.np,https://platform.technirvana.com.np
# With ENV/APP_ENV=production + TENANT_BASE_DOMAIN, POS links become https://{slug}.TENANT_BASE_DOMAIN/
# In development, remote POS_PUBLIC_URL values are ignored so local Serve login stays on localhost.
