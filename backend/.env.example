

#Database env 

#This for db
# enum are development, production , test
NODE_ENV=

#DB for dev mode
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres

#DB for staging mode
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_DIALECT=postgres

#DB for prod mode
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_NAME=
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_DIALECT=postgres


#App
APP_NAME=UNI-MOMO
PORT=8080

#this is for app
ENV=development


WEBHOOK_SECRET=justarandomsecretvalue


APP_SECRET_ENCRYPTION_KEY=

# Machbank eMerchant / NEPALPAY dynamic QR

MACHBANK_EMERCHANT_ENABLED=false
MACHBANK_BASE_URL=
MACHBANK_QR_GENERATE_URL=
# MACHBANK_QR_INQUIRY_URL=
MACHBANK_WS_URL=
MACHBANK_MERCHANT_CODE=
# Merchant mid from Machbank (e.g. 1501KQZRFMY) — NCHL merchantId field
MACHBANK_MERCHANT_MID=
MACHBANK_MERCHANT_NAME=
MACHBANK_MERCHANT_CITY=Kathmandu
# NCHL doc examples use 4600 for Kathmandu
MACHBANK_MERCHANT_POSTAL_CODE=4600
# MACHBANK_QR_SPLIT_TERMINAL_LABEL=false
# NCHL token string field 7 — from Machbank; not the same as MACHBANK_USERNAME
MACHBANK_NPI_USER_ID=
MACHBANK_ACQUIRER_ID=
# ISO 18245 MCC — merchantCategoryCode in body AND in signed token string (must match bank enrollment)
MACHBANK_MCC=
MACHBANK_TERMINAL_LABEL=
MACHBANK_STORE_LABEL=
# MACHBANK_QR_REQUEST_IMAGE=false to return qrString only; bank sample uses true
MACHBANK_USERNAME=
MACHBANK_PASSWORD=
MACHBANK_WS_USERNAME=
MACHBANK_API_TOKEN=
MACHBANK_GETPAY_PUBLIC_KEY_PATH=
MACHBANK_TLS_CERT_PATH=./secrets/machbank-client.crt
MACHBANK_TLS_PRIVATE_KEY_PATH=./secrets/machbank-client.key
MACHBANK_QR_PRIVATE_KEY_PATH=./secrets/qr-signing-private.pem
MACHBANK_CURRENCY=NPR
# Security (recommended: leave true in production)
MACHBANK_REQUIRE_GETPAY_SIGNATURE=true
MACHBANK_WS_STRICT_PARSE=true
# Sandbox only: log redacted nqrws messages (ignored if NODE_ENV or ENV=production)
MACHBANK_WS_DEBUG_LOG=false
# Optional app tuning (defaults exist in config only for these)
MACHBANK_QR_EXPIRY_SECONDS=300
MACHBANK_HTTP_TIMEOUT_MS=15000
MACHBANK_WS_RECONNECT_MAX_MS=60000
MACHBANK_WS_HEARTBEAT_MS=30000

# Platform superadmin (admin.servecafe.app / localhost:7002)
PLATFORM_JWT_SECRET=
PLATFORM_ADMIN_USERNAME=technirvana
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Tech Nirvana
# POS_PUBLIC_URL=http://localhost:7001
